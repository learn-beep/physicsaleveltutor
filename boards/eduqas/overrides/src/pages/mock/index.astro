---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Eduqas A-level Physics mini-mock builder: timed papers from real questions" description="Build a timed mini-mock from real Eduqas Physics past-paper questions in the shape of Component 1, 2 or 3 with your option (or the AS components): whole structured questions or a full paper. Play it on screen or print it with the mark schemes." context="mock" leadLine="Want a mock marked properly and gone through? Message us.">
  <h1>Mini-mock builder</h1>
  <p>Assembles a paper from real Eduqas questions in the shape of the exam. A-level Component 1 is 80 marks of structured questions (Section A) and a 20-mark comprehension (Section B), in 2 hours 15 minutes. Component 2 is 100 marks in 2 hours. Component 3 is 100 marks on light, nuclei, magnetic fields and induction (Section A) and 20 marks on your option (Section B), in 2 hours 15 minutes. Each AS component is 75 marks in 1 hour 30 minutes. Questions are kept whole, so every part has the information it needs. Have the Data Booklet beside you.</p>
  <div class="panel" id="setup">
    <h3>Component</h3>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="Component 1" aria-pressed="true">Component 1</button><button class="chip" type="button" data-v="Component 2">Component 2</button><button class="chip" type="button" data-v="Component 3">Component 3 (with your option)</button></div>
    <h3>Level</h3>
    <div class="chips" data-group="level"><button class="chip" type="button" data-v="A level" aria-pressed="true">A level</button><button class="chip" type="button" data-v="AS">AS</button></div>
    <h3>Option (A-level Component 3 only)</h3>
    <div class="chips" data-group="opt"><button class="chip" type="button" data-v="alternating-currents" aria-pressed="true">A: Alternating currents</button><button class="chip" type="button" data-v="medical-physics">B: Medical physics</button><button class="chip" type="button" data-v="physics-of-sports">C: The physics of sports</button><button class="chip" type="button" data-v="energy-and-the-environment">D: Energy and the environment</button></div>
    <h3>Length</h3>
    <div class="chips" data-group="part"><button class="chip" type="button" data-v="B" aria-pressed="true">About 40 marks</button><button class="chip" type="button" data-v="full">Full paper</button></div>
    <p class="muted" id="shape"></p>
    <div><button class="btn btn-accent" type="button" id="build">Build my mock</button></div>
  </div>
  <div id="paper" hidden>
    <div class="playbar"><span id="title"></span><span class="timer" id="timer"></span><span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start timer</button> <button class="btn" type="button" id="print"><Icon name="printer" />Print</button> <button class="btn" type="button" id="share"><Icon name="link" />Copy link</button></span></div>
    <div id="cards"></div>
    <div class="btn-row"><button class="btn btn-accent" type="button" id="rebuild">Build another</button></div>
  </div>
  <script>
    import { loadBank, card, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = { paper: 'Component 1', level: 'A level', part: 'B', opt: 'alternating-currents' };
    let bank = null, timer = null, secs = 0;
    const OPTS = ['alternating-currents', 'medical-physics', 'physics-of-sports', 'energy-and-the-environment'];
    // [marks, seconds per mark] for each component as a student sits it
    const SHAPE = { 'A level': { 'Component 1': [100, 81], 'Component 2': [100, 72], 'Component 3': [120, 67] }, AS: { 'Component 1': [75, 72], 'Component 2': [75, 72] } };
    const shapeOf = () => SHAPE[sel.level][sel.paper];
    const mins = (m, sh) => Math.round(m * sh[1] / 60);
    function shape() {
      const sh = shapeOf();
      if (!sh) { $('#shape').textContent = 'There is no AS Component 3; the AS components are Component 1 and Component 2.'; return; }
      const al = sel.level === 'A level';
      const t = { B: `Whole questions adding up to about 40 marks (about ${mins(40, sh)} minutes)${al && sel.paper === 'Component 3' ? ', including one question from your option' : ''}.`,
        full: al && sel.paper === 'Component 1' ? 'Section A: 80 marks of structured questions. Section B: a 20-mark comprehension (100 marks, 2 hours 15 minutes).'
          : al && sel.paper === 'Component 3' ? 'Section A: 100 marks on light, nuclei and fields. Section B: 20 marks on your option (120 marks, 2 hours 15 minutes).'
          : `${sh[0]} marks of structured questions (${al ? '2 hours' : '1 hour 30 minutes'}).` };
      $('#shape').textContent = t[sel.part];
    }
    document.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => { g.querySelectorAll('.chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); sel[g.dataset.group] = b.dataset.v; shape(); })));
    shape();
    loadBank().then((b) => { bank = b; });
    const groupsOf = (qs) => { const m = new Map(); for (const q of qs) { if (!m.has(q.g)) m.set(q.g, []); m.get(q.g).push(q); } return [...m.values()]; };
    const marksOf = (g) => g.reduce((a, q) => a + q.m, 0);
    const isOpt = (g) => g.some((q) => q.t.some((t) => OPTS.includes(t)));
    const optOf = (g) => OPTS.find((o) => g.some((q) => q.t.includes(o)));
    const isComp = (g) => g.some((q) => q.t.includes('comprehension'));
    function fill(groups, target) {
      const out = []; let total = 0;
      for (const g of groups) { const m = marksOf(g); if (total + m <= target + 3) { out.push(g); total += m; } if (total >= target - 2) break; }
      return out;
    }
    $('#build').addEventListener('click', () => {
      if (!bank) return;
      const sh = shapeOf(); if (!sh) return;
      const al = sel.level === 'A level';
      const pool = bank.q.filter((q) => !q.old && q.c && q.l === sel.level && q.p === sel.paper);
      const groups = shuffle(groupsOf(pool));
      let picked = [];
      const add = (g) => { picked = picked.concat(g.slice().sort((a, b) => a.q.localeCompare(b.q, undefined, { numeric: true }))); };
      if (al && sel.paper === 'Component 3') {
        const core = groups.filter((g) => !isOpt(g)), opt = groups.filter((g) => optOf(g) === sel.opt);
        if (sel.part === 'B') { fill(core, 20).forEach(add); fill(opt, 20).forEach(add); } else { fill(core, 100).forEach(add); fill(opt, 20).forEach(add); }
      } else if (al && sel.paper === 'Component 1') {
        const a = groups.filter((g) => !isComp(g)), c = groups.filter(isComp);
        if (sel.part === 'B') fill(a, 40).forEach(add); else { fill(a, 80).forEach(add); if (c.length) add(c[0]); }
      } else fill(groups, sel.part === 'B' ? 40 : sh[0]).forEach(add);
      if (!picked.length) { $('#shape').textContent = 'Nothing matched; try another combination.'; return; }
      const total = picked.reduce((a, q) => a + q.m, 0);
      $('#setup').hidden = true; $('#paper').hidden = false;
      $('#title').textContent = `${sel.level} ${sel.paper}: ${picked.length} parts, ${total} marks`;
      secs = Math.round(total * sh[1]); $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      renderPicked(picked);
      location.hash = 'set=' + picked.map((q) => q.id).join(',');
      window.scrollTo({ top: 0 });
    });
    function renderPicked(picked) { const holder = $('#cards'); holder.innerHTML = ''; let lastG = null; picked.forEach((q, n) => { const c = card(q, { mcq: true }); c.querySelector('.meta strong').textContent = `Part ${n + 1} (from ${q.s} ${q.l === 'AS' ? 'AS ' : ''}${q.p} Q${q.q})`; if (q.g === lastG) { const st = c.querySelector('details.stem'); if (st) st.remove(); } lastG = q.g; holder.appendChild(c); }); }
    $('#share').addEventListener('click', async () => { const url = location.href.split('#')[0] + location.hash; try { await navigator.clipboard.writeText(url); window.maltToast && window.maltToast('Link copied'); } catch { prompt('Copy this link', url); } });
    loadBank().then(() => { const m = location.hash.match(/set=([^&]+)/); if (!m || !bank) return; const ids = decodeURIComponent(m[1]).split(','); const picked = ids.map((id) => bank.q.find((q) => q.id === id)).filter(Boolean); if (!picked.length) return; const total = picked.reduce((a, q) => a + q.m, 0); $('#setup').hidden = true; $('#paper').hidden = false; $('#title').textContent = `Shared mock: ${picked.length} parts, ${total} marks`; secs = Math.round(total * 80); $('#timer').textContent = fmtTime(secs); renderPicked(picked); });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    $('#print').addEventListener('click', () => { document.querySelectorAll('#cards img[data-src]').forEach((img) => { img.src = img.dataset.src; img.removeAttribute('data-src'); }); document.querySelectorAll('#cards details.stem').forEach((d) => { d.open = true; }); setTimeout(() => window.print(), 300); });
    $('#rebuild').addEventListener('click', () => { if (timer) clearInterval(timer); $('#paper').hidden = true; $('#setup').hidden = false; window.scrollTo({ top: 0 }); });
  </script>
</Base>
