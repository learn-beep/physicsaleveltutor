---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers } from '../lib/data';
import Icon from '../components/Icon.astro';
import { badgeClass, badgeText } from '../lib/groups';
const top = [...allTopics].filter((t) => !t.option).sort((a, b) => b.parts - a.parts).slice(0, 16);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const current = allQuestions.filter((q) => !q.notCurrentSpec).length;
const latest = allPapers.filter((p) => p.kind === 'exam').map((p) => p.series).sort((a, b) => Number(b.split(' ')[1]) - Number(a.split(' ')[1]))[0];
---
<Base title="Eduqas A-level Physics: past-paper questions by topic, mark schemes and tutors" description="Free Eduqas (WJEC) A-level and AS Physics past-paper questions by topic, mark schemes, examiners' comments, practice and the Data Booklet, with a specialist physics tutor." context="home" leadLine="Not sure where to start? Tell us the year group and target grade and we will arrange a trial session.">
  <h1>Eduqas A-level Physics, one topic at a time</h1>
  <p>{current.toLocaleString()} question parts from {allPapers.length} Eduqas Physics papers from June 2016 to {latest}, sorted by topic, with the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">WJEC Eduqas A-level A420QS and AS B420QS Physics. A level is three components: Newtonian physics; Electricity and the universe; Light, nuclei and options (one of Alternating currents, Medical physics, The physics of sports, Energy and the environment). The June 2026 papers will be added when Eduqas makes them public.</p>

  <p class="board-note">This is the <strong>Eduqas</strong> section. Studying AQA (7408 / 7407)? <a href="/">Go to the AQA section</a>.</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/data-booklet/"><Icon name="book" />Data Booklet</a>
    <a href="/maths-skills/"><Icon name="calculator" />Calculations</a>
    <a href="/specified-practicals/"><Icon name="checklist" />Practicals</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="e.g. kinematics, capacitance, photons, vibrations" autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={badgeClass(t.group)}>{badgeText(t.group)}</span> {t.parts} parts</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics, including the four options</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every A420QS and B420QS paper since 2016 with a question-by-question table, mark schemes and examiners' comments</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time, self-marked against the mark scheme, with scores by topic</span></a>
    <a class="tile-card" href="/data-booklet/"><Icon name="book" /><strong>Data Booklet</strong><span>What the Eduqas Data Booklet gives you, and what you have to learn</span></a>
    <a class="tile-card" href="/maths-skills/"><Icon name="calculator" /><strong>Calculations</strong><span>Every calculation, graph and uncertainty question, with the marks the scheme gives for maths</span></a>
    <a class="tile-card" href="/specified-practicals/"><Icon name="checklist" /><strong>Specified practicals</strong><span>All 26 specified practicals and every past-paper question on them</span></a>
    <a class="tile-card" href="/six-mark-questions/"><Icon name="layers" /><strong>QER questions</strong><span>Every six-mark quality of extended response question, by topic, with a timed tool</span></a>
    <a class="tile-card" href="/flashcards/"><Icon name="layers" /><strong>Flashcards</strong><span>Definitions topic by topic, with spaced repetition</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A component-shaped timed mock from real questions: Component 1, 2, 3 with your option, or AS</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every statement of the specification, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks by topic since 2017, the latest papers, every paper as a timeline</span></a>
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculator and the 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Your tutor</strong><span>Online one-to-one lessons with Rosey, who currently teaches A-level physics at a top sixth-form college</span></a>
  </div>


  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('malt-edq-spec') || '{}'), scores = JSON.parse(localStorage.getItem('malt-edq-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} parts</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
